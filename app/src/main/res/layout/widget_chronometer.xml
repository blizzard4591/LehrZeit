<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's running time. Glance has no chronometer, so this plain view is embedded. -->
<Chronometer xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_chronometer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fontFeatureSettings="tnum"
    android:singleLine="true"
    android:textColor="@color/widget_on_primary_container"
    android:textSize="18sp"
    android:textStyle="bold" />
