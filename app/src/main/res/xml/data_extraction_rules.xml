<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer. The timetable link contains a secret token, so it isn't backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/timetable.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/timetable.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
